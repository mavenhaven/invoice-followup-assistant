# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored).
# On Streamlit Community Cloud paste the same content into the app's Secrets box.
# Never commit real values.

# The long id in the sheet URL: https://docs.google.com/spreadsheets/d/<sheet_id>/edit
sheet_id = "PASTE_SHEET_ID_HERE"

# Optional: name of the tab that holds the invoices. Leave out to use the first tab.
# invoices_tab = "Invoices"

# Strongly recommended on a public URL: everyone who opens the app must enter this before seeing anything.
# Without it, anyone who has the link can run follow-ups and approve payment dates.
# (Also consider restricting who can view the app in Streamlit's sharing settings.)
app_password = "CHOOSE_A_LONG_PASSWORD"

# Contents of the Google service account JSON key. Share the sheet with client_email as Editor.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
